@using ProductStore.Web.DTOs
@model ProductDTO

@{
    ViewData["Title"] = "Producto";
}

<div class="pagetitle">
    <h1>Dashboard</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Category" asp-route-id="@Model.CategoryId">Categoría</a></li>
            <li class="breadcrumb-item active">Producto</li>
        </ol>
    </nav>
</div>

<section class="section dashboard">

    <div class="card">

        <div class="card-header">@Model.Name</div>

        <div class="card-body mt-2">
            @Html.Raw(Model.Name)
        </div>

    </div>
</section>